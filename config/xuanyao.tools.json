{
  "version": "1.17",
  "name": "玄曜工具層",
  "policy": {
    "local_safe_tools_auto_run": true,
    "external_tools_require_confirmation": true,
    "paid_or_irreversible_actions_require_confirmation": true,
    "structured_ai_actions_enabled": true,
    "real_tool_execution_enabled": true,
    "tool_result_return_enabled": true,
    "result_validation_enabled": true,
    "failure_recovery_enabled": true,
    "memory_ranking_enabled": true,
    "workflow_ordering_enabled": true,
    "error_diagnostics_enabled": true,
    "autonomous_judgment_enabled": true,
    "unknown_option_exploration_enabled": true,
    "unknown_option_verification_enabled": true,
    "decision_history_enabled": true,
    "local_context_awareness_enabled": true,
    "research_planning_enabled": true,
    "verification_queue_enabled": true,
    "research_evidence_store_enabled": true,
    "evidence_lifecycle_enabled": true
  },
  "tools": [
    {"id":"memory.save","name":"儲存記憶","scope":"local","risk":"safe","enabled":true},
    {"id":"memory.search","name":"搜尋記憶","scope":"local","risk":"safe","enabled":true},
    {"id":"task.create","name":"建立任務","scope":"local","risk":"safe","enabled":true},
    {"id":"task.complete","name":"完成任務","scope":"local","risk":"safe","enabled":true},
    {"id":"data.export","name":"匯出資料","scope":"local","risk":"safe","enabled":true},
    {"id":"intent.route","name":"意圖路由","scope":"local","risk":"safe","enabled":true},
    {"id":"structured.plan","name":"結構化規劃","scope":"local","risk":"safe","enabled":true},
    {"id":"external.request","name":"外部工具請求","scope":"external","risk":"confirm","enabled":true},
    {"id":"tool.execution","name":"工具執行循環","scope":"backend","risk":"controlled","enabled":true},
    {"id":"tool.result","name":"工具結果回傳","scope":"backend","risk":"controlled","enabled":true},
    {"id":"decision.record","name":"自主判斷紀錄","scope":"local","risk":"safe","enabled":true},
    {"id":"option.verify","name":"未知方案驗證","scope":"local","risk":"safe","enabled":true},
    {"id":"research.plan","name":"研究問題規劃","scope":"local","risk":"safe","enabled":true},
    {"id":"research.record","name":"研究證據紀錄","scope":"local","risk":"safe","enabled":true},
    {"id":"research.reassess","name":"證據後重新判斷","scope":"local","risk":"safe","enabled":true}
  ]
}